{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3 @@ROOT@@/.claude/hooks/session_start.py",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 @@ROOT@@/.claude/hooks/user_prompt_submit.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 @@ROOT@@/.claude/hooks/session_end.py",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 @@ROOT@@/.claude/hooks/context_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "autoMemoryDirectory": "@@MEMORY@@"
}
